
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum UserType {
  email
  kakao
}
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  sectors   Sector[]
  type      UserType   @default(email)
}

model Sector {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stocks  Stock[]  @relation("SectorStocks")
  createdAt DateTime @default(now())
}

model Stock {
  id        String   @id @default(cuid())
  name      String
  code      String
 sector   Sector   @relation("SectorStocks", fields: [sectorId], references: [id], onDelete: Cascade)
  sectorId String
}
model DailyPrice {
  id     String   @id @default(cuid())
  name   String
  code   String   @default("")
  open   Int?
  high   Int?
  low    Int?
  close  Int
  date   DateTime
  createdAt DateTime @default(now())
}

model TickerInfo {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  market String @default("")// "KOSDAQ" or "KOSPI"
}
model MarketCapRanking {
  id         String   @id @default(cuid())
  code       String              // 종목 코드
  name       String              // 종목명
  market     String              // 시장 구분 (예: KOSPI, KOSDAQ)
  closePrice Int                 // 종가
  diffPrice  Int                 // 전일대비 등락
  diffRate   Float               // 전일대비 등락률
  volume     Int                 // 거래량
  tradeAmount String             // 거래대금
  marketCap  String              // 시가총액
  marketCapRatio Float           // 시가총액 비중(%)
  sharesOutstanding String       // 유통주식수
  date       DateTime            // 수집 일자 (날짜 기준, 예: 2025-06-23)
  createdAt  DateTime @default(now())

  @@index([date])
  @@index([code, date])
}
